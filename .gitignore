# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Assets crudos de marca (manual pesado + variantes) — no desplegar; usar /public/brand
/branding/

# 🔒 Documentos y datos confidenciales — nunca versionar ni desplegar
*.pdf
/confidencial/
/secrets/
*credentials*
*recovery-codes*
*account_details*
EIN*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Assets crudos del brandbook (pesados) — usar /public/brand y src/app/fonts
/Branding de marca/
